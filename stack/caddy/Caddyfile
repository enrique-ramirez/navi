{
	admin off

	# Certificates come from Caddy's own internal CA (the `tls internal` lines
	# below). `disable_redirects` rather than `off`: we want certificate
	# management, but must NOT redirect http to https, because anything that
	# can't install a root CA (smart TVs, consoles, a guest's laptop) still needs
	# the plain HTTP versions to work.
	auto_https disable_redirects
}

# =========================================================== plain HTTP
# For devices that can't trust the internal CA, and as the always-works path.

http://home.lan, http://help.lan, http://navi.lan, http://10.100.100.53 {
	# Files written by timers into /srv/data/www: repo-vs-origin state, this
	# box's own vitals, and the rolled-up history behind each vitals tile.
	# Named matcher because `handle` takes one path.
	@state path /status.json /host.json /history/*
	handle @state {
		root * /srv/status
		file_server
	}
	handle {
		root * /srv/www
		file_server
	}
}

http://status.lan {
	reverse_proxy 127.0.0.1:3001
}

# The router, proxied rather than pointed at directly.
#
# The ER605 answers on 443 with a certificate TP-Link generated in 2018, so a
# browser that auto-upgrades to HTTPS lands on a warning every time. Fronting it
# here means the browser sees a certificate from our own CA instead.
#
# Backend is the router's plain HTTP, and it has to be. Proxying to its HTTPS
# fails with `remote error: tls: handshake failure`: the ER605's TLS stack dates
# from 2018 and only offers cipher suites that Go's client refuses. curl connects
# because it's more permissive. Caddy's http transport exposes no minimum-version
# knob for upstreams, so there's no way to negotiate down.
#
# That leaves the navi-to-router hop in cleartext. It's one switched hop on the
# same wire, and it's exactly what happens today when you browse to
# http://10.100.100.1 directly. Browser-to-navi is now encrypted, which shrinks
# the plaintext segment rather than growing it.
#
# 10.100.100.1 still works directly. That's the escape hatch for when Caddy or
# navi is the thing that's broken.
http://router.lan, http://gate.lan {
	# Do NOT rewrite the Host header here. The ER605 gates its static assets on
	# the Referer matching the Host: it doesn't care what the host is, only that
	# the two agree. Setting Host to 10.100.100.1 while the browser sends
	# Referer: router.lan makes every .js and .css 404, the app falls through to
	# error.html, and you get a blank page. Caddy passes the original Host by
	# default, so both are router.lan and they match.
	reverse_proxy 10.100.100.1
}

http://dns.lan {
	redir / /admin/ 302
	reverse_proxy 127.0.0.1:8081
}

# Music is the one service that is HTTPS-only.
#
# Jean needs a secure context for navigator.mediaSession (lock screen, media
# keys) and Notification, and over plain HTTP both are silently missing. So
# HTTP redirects to HTTPS: a device without the root CA gets a certificate
# warning rather than a Jean that works minus features nobody notices are gone.
#
# This used to be forced rather than chosen, when beefweb served the page and
# Jean reached foo_jean on a second port that had to share the page's scheme.
# foo_jean now serves Jean itself, on one origin, so that reason is gone.
#
# On a device that can't trust the CA, go direct to the player at
# http://10.100.100.50:8881/, which bypasses Caddy entirely.
http://music.lan, http://ocarina.lan {
	redir https://{host}{uri} 308
}

# =========================================================== HTTPS
# Same names, same services, certificates issued by Caddy's internal CA.
#
# Install the root from
#   /srv/data/caddy/caddy/pki/authorities/local/root.crt
# on a device and these load with no warning AND count as a secure context,
# which is the whole point: Jean needs one for navigator.mediaSession (lock
# screen and hardware media keys) and Notification.
#
# The bare IP is deliberately left HTTP-only. It's the "DNS is broken" escape
# hatch and should have as few moving parts as possible.

https://home.lan, https://help.lan, https://navi.lan {
	tls internal
	# Files written by timers into /srv/data/www: repo-vs-origin state, this
	# box's own vitals, and the rolled-up history behind each vitals tile.
	# Named matcher because `handle` takes one path.
	@state path /status.json /host.json /history/*
	handle @state {
		root * /srv/status
		file_server
	}
	handle {
		root * /srv/www
		file_server
	}
}

https://status.lan {
	tls internal
	reverse_proxy 127.0.0.1:3001
}

https://router.lan, https://gate.lan {
	tls internal
	# Do NOT rewrite the Host header here. The ER605 gates its static assets on
	# the Referer matching the Host: it doesn't care what the host is, only that
	# the two agree. Setting Host to 10.100.100.1 while the browser sends
	# Referer: router.lan makes every .js and .css 404, the app falls through to
	# error.html, and you get a blank page. Caddy passes the original Host by
	# default, so both are router.lan and they match.
	reverse_proxy 10.100.100.1
}

https://dns.lan {
	tls internal
	redir / /admin/ 302
	reverse_proxy 127.0.0.1:8081
}

# foo_jean serves Jean at / and its API beside it, on one origin, so this is a
# plain pass-through. There used to be a second vhost on :8881 for foo_jean,
# which beefweb's page reached cross-port; one origin retired it.
https://music.lan, https://ocarina.lan {
	tls internal

	# Jean lived at /jean/ under beefweb, and phones and bookmarks still say so.
	# foo_jean doesn't answer there, so send them home instead of to a 404.
	@beefweb_path path /jean /jean/*
	redir @beefweb_path / 302

	reverse_proxy {$MUSIC_BACKEND} {
		# Jean holds long-lived responses open: the live player-state stream and
		# the audio stream itself. A buffering proxy stalls both: the UI would
		# load fine and then silently stop updating, or the music would stutter.
		#
		# Caddy does auto-detect text/event-stream and disable buffering, so this
		# worked before it was written down. Stated explicitly because relying on
		# an auto-detection you never chose is how it breaks quietly later, and
		# because an audio stream isn't text/event-stream.
		flush_interval -1
	}
}
