# Copy to /srv/navi/.env on navi, fill in, chmod 600.
# Gitignored. Real values live in 1Password.

TZ=America/Mexico_City

# --- Pi-hole -----------------------------------------------------------------
# No username in v6, password only.
PIHOLE_PASSWORD=changeme

# Upstream resolvers, semicolon separated. One from each of two providers so a
# single provider's outage isn't fatal.
# Measured from navi 2026-09-03: Cloudflare 9ms, Quad9-2 12ms, Google 14ms,
# OpenDNS 49ms. Don't pick these by ping: Cloudflare deprioritises ICMP and
# pings at ~52ms while answering DNS in 9ms.
PIHOLE_UPSTREAMS=1.1.1.1;149.112.112.112

# Local DNS names, semicolon separated, each entry "IP name [name...]".
# Setting these by env makes them read-only in the Pi-hole UI, which is the
# point: the repo is the source of truth, not the web form.
PIHOLE_HOSTS=10.100.100.53 navi navi.lan;10.100.100.53 home.lan help.lan status.lan dns.lan;10.100.100.53 ocarina ocarina.lan music.lan;10.100.100.53 gate gate.lan router.lan

# --- music backend -----------------------------------------------------------
# Both move to 10.100.100.50 when ocarina is built. Nothing else changes.
MUSIC_BACKEND=10.100.100.20:8880
MUSIC_FOOJEAN=10.100.100.20:8881

# --- per-WAN probes ----------------------------------------------------------
# Source aliases on eth0, pinned to a WAN by ER605 policy routes.
# The expected values are the public IPs each line egresses from; the check
# fails if it sees the wrong one, which is how a broken policy route surfaces
# as an alert instead of a monitor silently testing the wrong line.
WAN1_SRC=10.100.100.61
WAN1_EXPECT=187.211.43.253
WAN2_SRC=10.100.100.62
WAN2_EXPECT=189.196.218.19

# --- Uptime Kuma push tokens -------------------------------------------------
# From each push monitor's URL in the Kuma UI.
KUMA_PUSH_WAN1=
KUMA_PUSH_WAN2=
KUMA_PUSH_BLOCKING=
KUMA_PUSH_GRAVITY=
KUMA_PUSH_ATTENTION=
# Leave blank to disable the SSH monitor. wan-check.sh defaults it to empty and
# skips the push, so an .env that predates this key still works.
KUMA_PUSH_SSH=
