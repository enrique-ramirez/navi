{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["vite/client", "node"],
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
	},
	// The whole of src: a test imports the component it covers, and a composite
	// project cannot import a file outside its own include.
	"include": ["src"]
}
