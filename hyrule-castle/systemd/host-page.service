[Unit]
Description=The vitals page and its restart button
Documentation=file:///srv/navi/docs/hyrule-castle.md
After=network-online.target

[Service]
Type=simple
User=vitals
Group=vitals

AmbientCapabilities=CAP_NET_BIND_SERVICE

# NoNewPrivileges and CapabilityBoundingSet stay unset: sudo is setuid and
# needs CAP_SETUID and CAP_SETGID, so with either set the restart button fails.

# The access log and the restart line go to stderr, which Python buffers when
# it is a pipe to journald rather than a terminal, so nothing reached the
# journal until the process exited.
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 /usr/local/lib/vitals/server.py \
    --port 80 \
    --page /usr/local/lib/vitals/page \
    --data /srv/data/www \
    --config /etc/vitals.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
